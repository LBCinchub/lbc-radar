{
  "name": "NewsPost",
  "type": "object",
  "properties": {
    "headline": {
      "type": "string"
    },
    "content": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "pending",
        "verified",
        "unverified",
        "false"
      ],
      "default": "pending"
    },
    "verification_summary": {
      "type": "string"
    },
    "verification_confidence": {
      "type": "number"
    },
    "region": {
      "type": "string"
    },
    "headline_en": {
      "type": "string"
    },
    "headline_ar": {
      "type": "string"
    },
    "content_en": {
      "type": "string"
    },
    "content_ar": {
      "type": "string"
    },
    "sentiment": {
      "type": "string",
      "enum": [
        "very_positive",
        "positive",
        "neutral",
        "negative",
        "very_negative"
      ],
      "description": "Market sentiment derived from article content"
    },
    "sentiment_confidence": {
      "type": "number",
      "description": "Confidence score for sentiment analysis (0.0 to 1.0)"
    },
    "mentioned_assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "symbol": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "stock",
              "commodity",
              "crypto"
            ]
          }
        }
      },
      "description": "Assets mentioned in the news article"
    },
    "executive_summary": {
      "type": "string",
      "description": "Concise AI-generated executive summary focused on geopolitical implications"
    },
    "key_impacts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Key geopolitical impacts from the news"
    }
  },
  "required": [
    "headline",
    "content"
  ]
}